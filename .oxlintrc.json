{
  "plugins": ["typescript", "react", "jsx-a11y"],
  "env": {
    "browser": true,
    "es2023": true,
    "node": true
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "off"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "off"
  }
}
